---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../../styles/global.css";

const projects = await getCollection("projects");

// Newest first; projects with no date sort to the end.
projects.sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>Projects | Matthew Micklewright</title>
    <meta
      name="description"
      content="Projects and things I've built."
    />
  </head>

  <body class="bg-gray-950 text-gray-100">

    <header class="mx-auto max-w-5xl px-6 py-6">
      <nav class="flex items-center justify-between">
        <a href="/" class="text-xl font-bold">
          Matthew Micklewright
        </a>

        <div class="flex items-center gap-6">
          <a
            href="https://github.com/MickleByte"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-gray-400 hover:text-white"
          >
            <svg
              viewBox="0 0 16 16"
              width="24"
              height="24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
          </a>

          <a
            href="https://www.linkedin.com/in/matt-micklewright-57135b218/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-gray-400 hover:text-white"
          >
            <svg
              viewBox="0 0 16 16"
              width="24"
              height="24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
              ></path>
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-16">

      <h1 class="text-4xl font-bold">
        Projects
      </h1>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {
          projects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="group overflow-hidden rounded-xl border border-gray-800 bg-gray-900 hover:border-gray-600"
            >
              {project.data.cover && (
                <Image
                  src={project.data.cover}
                  alt={project.data.coverAlt ?? ""}
                  widths={[400, 640, 960, 1440]}
                  sizes="(min-width: 1024px) 476px, (min-width: 768px) calc((100vw - 4.5rem) / 2), calc(100vw - 3rem)"
                  quality={90}
                  class="aspect-video w-full object-cover"
                />
              )}

              <div class="p-6">
                <h2 class="text-2xl font-semibold group-hover:text-blue-400">
                  {project.data.title}
                </h2>

                {project.data.description && (
                  <p class="mt-3 text-gray-400">
                    {project.data.description}
                  </p>
                )}

                <div class="mt-5 flex flex-wrap gap-2">
                  {
                    project.data.technologies.map((technology) => (
                      <span class="rounded-full bg-gray-800 px-3 py-1 text-sm">
                        {technology}
                      </span>
                    ))
                  }
                </div>
              </div>
            </a>
          ))
        }
      </div>

    </main>

  </body>
</html>