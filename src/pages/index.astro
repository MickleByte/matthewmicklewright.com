---
import { getCollection } from "astro:content";
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/global.css";

const projects = await getCollection("projects");

// Newest first; projects with no date sort to the end.
const sortedProjects = projects.sort(
  (a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0),
);

const featuredProjects = sortedProjects.slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>Matthew Micklewright | Software Engineer</title>
    <meta
      name="description"
      content="Portfolio of Matthew Micklewright, software engineer."
    />
  </head>

  <body class="bg-gray-950 text-gray-100">

    <Nav />

    <main>

      <!-- Hero -->
      <section class="mx-auto max-w-5xl px-6 py-24">

        <h1 class="mt-4 text-5xl font-bold tracking-tight">
          Matthew Micklewright
        </h1>

        <p class="mt-6 max-w-2xl text-xl text-gray-400">
          Software Engineer based in Nottingham, UK. I'm interested in full stack development,
          CI/CD, System Design and building things!
        </p>

      </section>


      <!-- Featured projects -->
      <section class="mx-auto max-w-5xl px-6 py-16">

        <div class="flex items-end justify-between">
          <h2 class="text-3xl font-bold">
            Projects
          </h2>

          <a
            href="/projects"
            class="text-gray-400 hover:text-white"
          >
            View all →
          </a>
        </div>

        <div class="mt-8 grid gap-6 md:grid-cols-3">

          {
            featuredProjects.map((project) => (
              <ProjectCard project={project} />
            ))
          }

        </div>

      </section>


    </main>

  </body>
</html>